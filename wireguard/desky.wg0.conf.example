# /etc/wireguard/wg0.conf  —  desky.local side (Fox monitor host)
#
# You almost certainly want install-client.sh in this directory rather
# than this template — it writes a clean config without any pasting,
# generation step or sudo gotchas:
#
#     curl -sL https://raw.githubusercontent.com/glenmo/smartenergylab_software/main/wireguard/install-client.sh \
#         | sudo bash
#
# If you do install by hand, generate the key first:
#     umask 077 && cd ~ && wg genkey | tee desky.key | wg pubkey > desky.pub
# Then paste desky.key into PrivateKey and burgan's PUBLIC key into
# the [Peer] PublicKey below.

[Interface]
Address    = 10.13.13.7/24
PrivateKey = REPLACE_WITH_desky.key_CONTENTS

[Peer]
PublicKey            = REPLACE_WITH_burgan.pub_CONTENTS
Endpoint             = burgan.arachnoid.net.au:41820     # MUST match burgan's ListenPort + UFW
AllowedIPs           = 10.13.13.0/24
PersistentKeepalive  = 25
