# /etc/wireguard/wg0.conf  —  burgan side (server)
#
# IMPORTANT: if burgan already has a wg0 interface running with other
# peers (which it usually does for personal-VPN reasons), do NOT
# overwrite this file by hand. Instead, dump the live config first so
# you don't lose the kernel-stored PrivateKey or any existing peers:
#
#     sudo wg showconf wg0 | sudo tee /etc/wireguard/wg0.conf.recovered
#     sudo cp /etc/wireguard/wg0.conf.recovered /etc/wireguard/wg0.conf
#
# Then APPEND the two [Peer] blocks below to the file (substituting
# the real desky/rubberduck pubkeys), then live-load with:
#
#     sudo bash -c 'wg-quick strip wg0 > /tmp/wg0.stripped \
#         && wg syncconf wg0 /tmp/wg0.stripped \
#         && rm /tmp/wg0.stripped'
#
# That preserves every existing peer's connection.
#
# The /24 subnet, the ListenPort, and the keys below should match
# whatever burgan was already running. The values shown here are the
# *deployed* values; substitute if you're standing up a fresh server.

[Interface]
Address     = 10.13.13.1/24
ListenPort  = 41820                                 # MUST match the UFW rule
PrivateKey  = REPLACE_WITH_burgan.key_CONTENTS

# UFW: don't forget to allow the port. Easy to forget — we did.
#     sudo ufw allow 41820/udp comment "WireGuard"
#     sudo ufw delete allow 51820/udp        # if a stale rule exists

# --- Peer: desky (Fox H3 monitor host) -------------------------------
[Peer]
PublicKey  = REPLACE_WITH_desky.pub_CONTENTS
AllowedIPs = 10.13.13.7/32

# --- Peer: rubberduck (Solis / microgrid host) -----------------------
[Peer]
PublicKey  = REPLACE_WITH_rubberduck.pub_CONTENTS
AllowedIPs = 10.13.13.8/32
